/* =============================================================================
   Moseng Backpack — UI Theme
   Forest green (#1E3327) base · cream (#F2EACB) text · amber (#C4A84A) accent
   ============================================================================= */

* {
    font-family: "DM Sans", "Inter", "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 12px;
    outline: none;
}

/* Base */
QMainWindow {
    background-color: $surface;
}

QWidget {
    background-color: transparent;
    color: $text;
}

/* ── Top Bar ── */
#topBar {
    background-color: $surface_low;
    border-bottom: 1px solid $border;
    min-height: 34px;
    max-height: 34px;
}

QToolButton#topBarBtn,
QPushButton#topBarBtn {
    background: transparent;
    color: $text_low;
    border: none;
    border-radius: 4px;
    font-size: 11px;
    padding: 3px 8px;
    font-family: "DM Sans", "Inter", "Segoe UI", sans-serif;
}
QToolButton#topBarBtn:hover,
QPushButton#topBarBtn:hover {
    background: rgba(255,255,255,10);
    color: $text;
}
QToolButton#topBarBtn::menu-indicator { image: none; }

/* ── Custom title bar: window title + min/max/close ── */
QLabel#titleLabel {
    color: $text_mid;
    font-size: 12px;
    font-weight: 600;
    font-family: "DM Sans", "Inter", "Segoe UI", sans-serif;
}
QPushButton#winMin, QPushButton#winMax, QPushButton#winClose {
    background: transparent;
    color: $text_mid;
    border: none;
    border-radius: 0;
    font-size: 13px;
}
QPushButton#winMin:hover, QPushButton#winMax:hover {
    background: rgba(255,255,255,22);
    color: $text;
}
QPushButton#winMin:pressed, QPushButton#winMax:pressed {
    background: rgba(255,255,255,33);
}
QPushButton#winClose:hover  { background: #c42b1c; color: #ffffff; }
QPushButton#winClose:pressed { background: #a8271a; color: #ffffff; }

/* ── Left Sidebar ── */
#sidebar {
    background-color: $surface_low;
    border-right: 1px solid $border;
}

#folderTreePanel {
    background-color: $surface_low;
}

#sidebarTitle {
    font-size: 9px;
    font-weight: 700;
    color: $text_low;
    letter-spacing: 1.8px;
    padding: 14px 14px 6px 14px;
    text-transform: uppercase;
}

/* ── Category Tree Items ── */
QPushButton.categoryItem {
    background-color: transparent;
    color: $text_mid;
    border: none;
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 11.5px;
    text-align: left;
}

QPushButton.categoryItem:hover {
    background-color: rgba(242,238,220,18);
    color: $text;
}

QPushButton.categoryItem:checked {
    background-color: $primary_bg;
    color: $primary_hover;
}

/* ── Tag chips in sidebar ── */
QPushButton.tagChip {
    border-radius: 5px;
    padding: 4px 9px;
    font-size: 11px;
    min-height: 26px;
    border: none;
    text-align: left;
}

QPushButton.tagChip:hover {
    background-color: rgba(242,238,220,10);
    color: $text;
}

QPushButton.tagChip:checked {
    background-color: $secondary_bg;
    color: $secondary_hover;
    border: 1px solid $secondary;
}

/* ── Grid Browser ── */
QListView#assetGrid {
    background-color: transparent;
    border: none;
    outline: none;
}

QListView#assetGrid::item          { background: transparent; border: none; outline: none; }
QListView#assetGrid::item:hover    { background: transparent; }
QListView#assetGrid::item:selected { background: transparent; }
QListView#assetGrid::item:focus    { background: transparent; outline: none; }

/* ── Scrollbars ── */
QScrollBar:vertical {
    background-color: transparent;
    width: 3px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: rgba(242,238,220,18);
    border-radius: 2px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(242,238,220,38);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,  QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
    border: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 3px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(242,238,220,18);
    border-radius: 2px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
    border: none;
}

/* ── Detail Panel ── */
#detailPanel {
    background-color: $surface_low;
    border-left: 1px solid $border;
}

/* ── Status Bar ── */
QStatusBar {
    background-color: $surface_low;
    color: $text_low;
    border-top: 1px solid $border;
    font-size: 10px;
    padding: 2px 12px;
    font-family: "DM Mono", "JetBrains Mono", "Consolas", monospace;
}

/* ── Buttons (default) ── */
QPushButton {
    background-color: rgba(242,238,220,8);
    color: $text_mid;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 5px 13px;
    font-size: 11.5px;
}

QPushButton:hover {
    background-color: rgba(242,238,220,14);
    color: $text;
    border-color: $border_hover;
}

QPushButton:pressed {
    background-color: $pressed_bg;
}

/* Primary action button */
QPushButton#primaryBtn {
    background: $primary;
    color: #1C2420;
    border: none;
    font-weight: 700;
    font-size: 11.5px;
    border-radius: 7px;
    padding: 6px 18px;
}

QPushButton#primaryBtn:hover {
    background: $primary_hover;
}

QPushButton#primaryBtn:pressed {
    background: $primary_pressed;
}

/* ── Drop Zone ── */
#dropZone {
    background-color: $surface_mid;
    border: 2px dashed $border;
    border-radius: 12px;
}

#dropZone:hover {
    border-color: $primary;
    background-color: $primary_bg;
}

/* ── Combo Box ── */
QComboBox {
    background-color: $surface_high;
    color: $text;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 5px 9px;
    min-width: 80px;
    font-size: 11.5px;
}

QComboBox:focus {
    border-color: $primary;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid $text_low;
    margin-right: 7px;
}

QComboBox QAbstractItemView {
    background-color: $surface_high;
    color: $text;
    border: 1px solid $border_hover;
    selection-background-color: $primary_bg;
    selection-color: $primary_hover;
    outline: none;
}

/* ── Dialog ── */
QDialog {
    background-color: $surface_low;
    color: $text;
}

/* ── Labels ── */
QLabel {
    color: $text;
    background-color: transparent;
}

QLabel#heading {
    font-size: 13px;
    font-weight: 600;
    color: $text;
    font-family: "DM Mono", "JetBrains Mono", "Consolas", monospace;
}

QLabel#subtext {
    color: $text_low;
    font-size: 11px;
}

QLabel#mapLabel {
    color: $text_mid;
    font-size: 10.5px;
    font-weight: 500;
}

/* ── Text / Line Inputs ── */
QTextEdit {
    background-color: rgba(242,238,220,6);
    color: $text;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 7px 9px;
    font-size: 11px;
    line-height: 1.65;
}

QTextEdit:focus {
    border-color: $primary;
    background-color: rgba(242,238,220,10);
}

QLineEdit {
    background-color: rgba(242,238,220,6);
    color: $text;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 11.5px;
}

QLineEdit:focus {
    border-color: $primary;
    background-color: rgba(242,238,220,10);
}

/* ── Progress Bar ── */
QProgressBar {
    background-color: $surface_high;
    border: none;
    border-radius: 2px;
    height: 3px;
    font-size: 0;
}

QProgressBar::chunk {
    background-color: $primary;
    border-radius: 2px;
}

/* ── Scroll Area ── */
QScrollArea {
    border: none;
    background-color: transparent;
}

/* ── List Widget ── */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget::item {
    padding: 3px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: $primary_bg;
    color: $primary_hover;
}

QListWidget::item:hover {
    background-color: rgba(242,238,220,8);
}

/* ── Splitter ── */
QSplitter::handle {
    background-color: $border;
    width: 1px;
}

/* ── Tooltip ── */
QToolTip {
    background-color: $surface_high;
    color: $text;
    border: 1px solid $border_hover;
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 11px;
}

/* ── Menu ── */
QMenu {
    background-color: $surface_high;
    color: $text;
    border: 1px solid $border_hover;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 5px 14px;
    border-radius: 4px;
    font-size: 11.5px;
}

QMenu::item:selected {
    background-color: rgba(242,238,220,12);
    color: $text;
}

QMenu::separator {
    height: 1px;
    background-color: $border;
    margin: 4px 8px;
}

/* ── Favorite Button ── */
QPushButton#favBtn {
    background: rgba(242,238,220,6);
    color: $text_low;
    border: 1px solid $border;
    border-radius: 6px;
    font-size: 11px;
}

QPushButton#favBtn:hover {
    border-color: $primary;
    color: $text;
    background: rgba(242,238,220,12);
}

QPushButton#favBtn:checked {
    background: $primary_bg;
    color: $primary_hover;
    border: 1px solid $primary;
}

/* ── Tag +Add Button ── */
QPushButton#tagAddBtn {
    background: $secondary_bg;
    color: $secondary_hover;
    border: 1px solid $secondary;
    border-radius: 5px;
    font-size: 10.5px;
    font-weight: 600;
    padding: 0 10px;
    min-height: 24px;
    max-height: 24px;
}

QPushButton#tagAddBtn:hover    { background: $secondary; color: $surface; }
QPushButton#tagAddBtn:pressed  { background: $secondary_pressed; }

/* ── Copy as Half Resolution Button ── */
QPushButton#dsHalfBtn {
    background: $primary;
    color: #1E3327;
    border: none;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#dsHalfBtn:hover    { background: $primary_hover; }
QPushButton#dsHalfBtn:pressed  { background: $primary_pressed; }
QPushButton#dsHalfBtn:disabled { background: $surface_high; color: $text_low; }

/* ── Message / Input Dialogs ── */
QMessageBox { background-color: $surface_low; }
QMessageBox QPushButton { min-width: 80px; }
QInputDialog { background-color: $surface_low; }
QColorDialog { background-color: $surface_low; }

/* ── Table ── */
QTableWidget {
    background-color: $surface_high;
    color: $text;
    gridline-color: $border;
    border: 1px solid $border;
    border-radius: 8px;
}

QTableWidget::item { padding: 5px; border: none; }
QTableWidget::item:selected { background-color: $primary_bg; color: $primary_hover; }

QHeaderView::section {
    background-color: $surface_low;
    color: $text_low;
    border: none;
    border-bottom: 1px solid $border;
    padding: 7px;
    font-weight: 700;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ── Toolbar checkable buttons (sort / view / quick-filter) ── */
QPushButton#subToolbarBtn {
    background: transparent;
    color: $text_low;
    border: none;
    border-radius: 4px;
    padding: 3px 9px;
    font-size: 11px;
    min-height: 22px;
}
QPushButton#subToolbarBtn:hover {
    background: rgba(255,255,255,10);
    color: $text;
}
QPushButton#subToolbarBtn:checked {
    background: $primary_bg;
    color: $primary_hover;
    border: 1px solid $primary;
}

/* ── Resolution chip (sidebar) ── */
QPushButton#resChip {
    background: transparent;
    color: $text_low;
    border: none;
    border-radius: 5px;
    padding: 3px 12px;
    text-align: left;
    font-size: 11px;
    min-height: 26px;
}
QPushButton#resChip:hover {
    background: rgba(255,255,255,10);
    color: $text;
}
QPushButton#resChip:checked {
    background: $primary_bg;
    color: $primary_hover;
    border: 1px solid $primary;
}

/* ── Filter panel: add / sort / search / active-filter bar / empty hint ── */
QPushButton#tagAddBtn {
    background: rgba(255,255,255,10);
    color: $primary;
    border: 1px solid $border;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
}
QPushButton#tagAddBtn:hover {
    background: rgba(255,255,255,20);
    border-color: $border_hover;
}

QPushButton#tagSortBtn {
    background: transparent;
    color: $text_low;
    border: 1px solid $border;
    border-radius: 4px;
    padding: 0 8px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.5px;
}
QPushButton#tagSortBtn:hover {
    color: $text;
    border-color: $border_hover;
    background: rgba(255,255,255,13);
}

QLineEdit#filterSearch {
    background: $surface;
    color: $text;
    border: 1px solid $border;
    border-radius: 5px;
    padding: 3px 8px;
    font-size: 11px;
    min-height: 22px;
    selection-background-color: $primary;
}
QLineEdit#filterSearch:focus {
    border-color: $primary;
}

#filterMetaBar { background: transparent; }
QLabel#filterCount {
    color: $text_mid;
    font-size: 10px;
    font-weight: 600;
}
QPushButton#filterClear {
    background: transparent;
    color: $primary;
    border: none;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 4px;
}
QPushButton#filterClear:hover {
    color: $primary_hover;
}

QLabel#tagEmptyHint {
    color: $text_low;
    font-size: 10.5px;
    padding: 16px 12px;
}

/* ── Collection (tray) panel ── */
#collectionPanel { background: $surface_low; }
QLabel#collectionCount {
    color: $text_mid;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}
QPushButton#collectionAdd,
QPushButton#collectionRemove,
QPushButton#collectionClear {
    border-radius: 5px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#collectionAdd {
    background: $primary_bg;
    color: $primary_hover;
    border: 1px solid $primary;
}
QPushButton#collectionAdd:hover { background: $surface_focus; }
QPushButton#collectionRemove,
QPushButton#collectionClear {
    background: transparent;
    color: $text_low;
    border: 1px solid $border;
}
QPushButton#collectionRemove:hover,
QPushButton#collectionClear:hover {
    color: $text;
    border-color: $border_hover;
    background: rgba(255,255,255,13);
}
QPushButton#collectionRemove:disabled,
QPushButton#collectionClear:disabled {
    color: $text_low;
    border-color: $border;
}
QLabel#collectionEmpty {
    color: $text_low;
    font-size: 12px;
    padding: 20px;
}

/* ── Quick-Open palette (Ctrl+K) ── */
QFrame#quickOpen {
    background: $surface_mid;
    border: 1px solid $primary;
    border-radius: 10px;
}
QLineEdit#quickOpenInput {
    background: $surface;
    color: $text;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 14px;
    selection-background-color: $primary;
}
QLineEdit#quickOpenInput:focus { border-color: $primary; }
QListWidget#quickOpenList {
    background: transparent;
    border: none;
    outline: none;
    font-size: 12px;
    color: $text_mid;
}
QListWidget#quickOpenList::item {
    padding: 5px 8px;
    border-radius: 5px;
}
QListWidget#quickOpenList::item:selected {
    background: $primary_bg;
    color: $primary_hover;
}

/* ── Synapse "show all connections" toggle ── */
QPushButton#synapseShowAll {
    background: $surface_mid;
    color: $text_mid;
    border: 1px solid $border;
    border-radius: 11px;
    padding: 3px 11px;
    font-size: 10px;
    font-weight: 600;
}
QPushButton#synapseShowAll:hover {
    color: $text;
    border-color: $border_hover;
}
QPushButton#synapseShowAll:checked {
    background: $primary_bg;
    color: $primary_hover;
    border-color: $primary;
}

/* ── 3D View button (detail panel) ── */
QPushButton#view3dBtn {
    background: $primary;
    color: $surface;
    border: none;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
    padding: 0 10px;
}
QPushButton#view3dBtn:hover  { background: $primary_hover; }
QPushButton#view3dBtn:pressed{ background: $primary_pressed; }

/* ── Houdini "Build RS Material" button (detail panel) ── */
QPushButton#houdiniBtn {
    background: $primary_bg;
    color: $primary_hover;
    border: 1px solid $primary;
    border-radius: 5px;
    font-size: 11px;
    padding: 0 10px;
    text-align: left;
}
QPushButton#houdiniBtn:hover    { background: $surface_focus; border-color: $primary_hover; color: $text; }
QPushButton#houdiniBtn:pressed  { background: $pressed_bg; }
QPushButton#houdiniBtn:disabled {
    background: $surface_low;
    color: $text_low;
    border-color: $border;
}

/* ═══════════════════════════════════════════════════════════════════════════
   Qt Advanced Docking System (QtAds) — 3D-app-style dockable panels
   ═══════════════════════════════════════════════════════════════════════════ */

ads--CDockManager,
ads--CDockContainerWidget {
    background: $surface;
}

/* Panel content frame */
ads--CDockWidget {
    background: $surface_low;
    border: none;
}

/* Dock area (group of tabbed panels) + its title bar */
ads--CDockAreaWidget {
    background: $surface_low;
    border: 1px solid $border;
}

ads--CDockAreaTitleBar {
    background: $surface_low;
    border-bottom: 1px solid $border;
    padding: 0;
    qproperty-spacing: 0;
}

/* Tabs — slim, sized to text */
ads--CDockWidgetTab {
    background: $surface_low;
    border: none;
    border-right: 1px solid $border;
    padding: 1px 6px;
    min-height: 18px;
}

ads--CDockWidgetTab[activeTab="false"]:hover {
    background: $surface_mid;
}

ads--CDockWidgetTab[activeTab="true"] {
    background: $primary_bg;
    border-bottom: 2px solid $primary;
}

/* The panel you're interacting with (FocusHighlighting) gets a brighter accent
   so the focused panel reads clearly — pairs with the white drop overlay. */
ads--CDockWidgetTab[focused="true"] {
    background: $surface_focus;
    border-bottom: 2px solid $primary_hover;
}

ads--CDockWidgetTab[focused="true"] QLabel {
    color: $secondary;
}

ads--CDockWidgetTab QLabel {
    color: $text_low;
    font-size: 11px;
    font-weight: 600;
}

ads--CDockWidgetTab[activeTab="true"] QLabel {
    color: $primary_hover;
}

/* Per-tab close button — overlaid at the right edge, faded in on hover (Python) */
ads--CDockWidgetTab QPushButton#tabCloseButton {
    border: none;
    background: transparent;
    padding: 0;
}

ads--CDockWidgetTab QPushButton#tabCloseButton:hover {
    background: $surface_high;
    border-radius: 3px;
}

/* Title-bar buttons (undock / options) */
ads--CTitleBarButton {
    background: transparent;
    border: none;
    padding: 2px;
}

ads--CTitleBarButton:hover {
    background: $surface_high;
    border-radius: 4px;
}

/* Per-panel '+' add-panel button (right edge of each panel's title bar) */
QToolButton#addPanelBtn {
    background: transparent;
    color: $text_mid;
    border: none;
    border-radius: 0;
    font-size: 15px;
    font-weight: 700;
    padding: 0;
}

QToolButton#addPanelBtn:hover {
    color: $primary_hover;
    background: $primary_bg;
    border-radius: 0;
}

QToolButton#addPanelBtn::menu-indicator {
    image: none;
    width: 0;
}

/* Splitter handles between docked panels */
ads--CDockContainerWidget QSplitter::handle {
    background: $border;
}

ads--CDockContainerWidget QSplitter::handle:hover {
    background: $primary;
}

/* Floating panel frame */
ads--CFloatingDockContainer {
    background: $surface;
    border: 1px solid $border_hover;
}

/* Drag preview — the snapshot that follows the cursor while moving a panel.
   An accent border makes the moving panel read clearly against the layout. */
ads--CFloatingDragPreview {
    background: $surface_low;
    border: 2px solid $primary;
}

/* Drop-zone indicators while dragging a panel — themed to the app palette
   (the default is a clashing bright blue). */
ads--CDockOverlayCross {
    qproperty-iconFrameColor: $border_hover;
    qproperty-iconBackgroundColor: $surface_low;
    qproperty-iconOverlayColor: $primary;
    qproperty-iconArrowColor: $primary_hover;
    qproperty-iconShadowColor: #000000;
}
